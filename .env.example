# Generate a strong password, e.g. openssl rand -hex 24.
ADMIN=replace-with-a-long-random-password
# Generate UUID and KEY once, or leave blank for a persisted UUID / upstream key.
UUID=
KEY=

# LOCAL: http://localhost:8080
# LAN:   http://192.168.1.10:8080 (replace with your server's address)
# HTTPS: https://vpn.example.com (with compose.https.yaml)
PUBLIC_URL=http://localhost:8080

# 127.0.0.1: this computer only / access through Caddy.
# Set your server's LAN IP to allow devices on your home network.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

# Required only for optional public HTTPS deployment.
VPN_DOMAIN=vpn.example.com
TUNNEL_PATH=/
OFF_LOG=true
DEBUG=false
# Native runtime tuning; Compose small-VM overrides set this automatically.
# This setting alone does not impose container memory or CPU limits.
RUNTIME_PROFILE=standard
# Outbound traffic connects directly by default.
PROXYIP=
